# GLM API配置
# 从智谱AI获取API Key: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# GLM API Base URL（默认值，通常不需要修改）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# GLM模型名称（默认glm-4）
GLM_MODEL=glm-4

# 温度参数（0.0-1.0，默认0.7）
TEMPERATURE=0.7

# 深度思考配置（GLM特有）
# 设置为 "disabled" 关闭深度思考，减少响应时间
# 设置为空或注释掉则启用深度思考（默认关闭以提升速度）
THINKING_TYPE=disabled

